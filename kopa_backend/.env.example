# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# SECURITY BOUNDARY
# Every secret below lives in this file, on the backend, only. None of these
# values may appear in kopa_app/ (the Flutter project), in any Dart source, in
# Flutter assets, or in any build output. The mobile app authenticates to
# kopa_backend and never to BMONI or Anthropic directly.

# --- BMONI Embedded -------------------------------------------------------
# Origin only. A trailing /v1 produces /v1/v1/... 404s.
BMONI_BASE_URL=https://embedded-dev.bmoni.com

# Sandbox partner key, sent as the x-api-key header. Never committed.
#
# For a sandbox run, BMONI publishes a shared key in their public quickstart at
# https://bkey.mintlify.app/api-quickstart — copy it from there into your local
# .env. We deliberately do not vendor it into this repository: it is a working
# credential, and a shared one, so anyone holding it can read every partner
# user registered against it. Request a private key from developers@bkey.me
# before anything resembling production.
BMONI_API_KEY=

# Smart-wallet calls take the stablecoin code, not the fiat one.
BMONI_CURRENCY=CNGN

# --- AI copilot -----------------------------------------------------------
# The explanation layer only. KOPA degrades gracefully without this: the
# deterministic verdict is still produced and shown.
ANTHROPIC_API_KEY=
KOPA_AI_MODEL=claude-sonnet-5

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kopa

# --- Application ----------------------------------------------------------
# When true, BMONI-dependent reads are served from seeded demo data so a flaky
# sandbox cannot break a live demo. The safety engine and the AI layer still run
# for real. Demo transactions are labelled as such in the UI and are never
# presented as real BMONI transactions.
KOPA_DEMO_MODE=false

KOPA_ENV=development
KOPA_LOG_LEVEL=INFO
